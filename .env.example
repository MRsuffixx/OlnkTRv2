# Core (required in production)
DATABASE_URL="postgresql://olnk:change-me@postgres:5432/olnktr"
REDIS_URL="redis://redis:6379"
APP_URL="http://localhost:3000"
AUTH_SECRET="generate-at-least-32-random-characters"
AUTH_TRUST_HOST="false"

# SMTP. Compose uses Mailpit at mailpit:1025; production must provide a real SMTP service.
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@olnk.test"
MAIL_FROM_NAME="OlnkTR"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage: local or s3
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./data/uploads"
STORAGE_PUBLIC_URL="http://localhost:3000/uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Development billing and privacy-preserving analytics
BILLING_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"
ANALYTICS_SALT="replace-with-a-rotatable-random-salt"
ACCOUNT_DELETION_GRACE_DAYS="7"

# Optional deterministic administrator bootstrap during seed
ADMIN_EMAIL="admin@example.com"
